replicaCount: 1

webapp:
  name: gdex-webserver
  group: gdex-web
  path: /
  tls:
    fqdn: tcram.k8s.ucar.edu
    fqdnAPI: api.tcram.k8s.ucar.edu
    secretName: incommon-cert-tcram-gdex-webserver
  container: 
    image: hub.k8s.ucar.edu/tcram-gdex/gdex-web-portal:v22778379997
    port: 8080
    requests:
      memory: 4Gi
      cpu: 1
    limits:
      memory: 16Gi
      cpu: 6
    responseTimeout: 180
    maxUploadSize: 60m
  ingress:
    ingressClassName: nginx-internal

volume:
  fs:
    existingClaim: gdexdata
    name: gdexdata
    mountPath: /data

# testName should match the release name used in the 'helm install' command
testName: tcram
