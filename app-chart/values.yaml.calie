replicaCount: 1

webapp:
  name: gdex-webserver
  group: gdex-web
  path: /
  tls:
    fqdn: calie.k8s.ucar.edu
    fqdnAPI: api.calie.k8s.ucar.edu
    secretName: incommon-cert-calie-gdex-webserver
  container: 
    image: hub.k8s.ucar.edu/calie-gdex/gdex-web-portal:latest
    port: 8080
    requests:
      memory: 4Gi
      cpu: 1
    limits:
      memory: 8Gi
      cpu: 6
    responseTimeout: 180
    maxUploadSize: 60m
  ingress:
    ingressClassName: nginx-internal

volume:
  fs:
    existingClaim: gdexdata
    name: gdexdata
    mountPath: /data

testName: calie