replicaCount: 1

webapp:
  name: gdex-webserver
  group: gdex-web
  path: /
  tls:
    fqdn: dattore.k8s.ucar.edu
    secretName: incommon-cert-dattore-gdex-webserver
  container: 
    image: docker.io/dattore/gdex-web-portal:v290
    port: 8080
    requests:
      memory: 4Gi
      cpu: 1
    limits:
      memory: 16Gi
      cpu: 6
    responseTimeout: 180
    maxUploadSize: 60m
  ingress:
    ingressClassName: nginx-internal
    oldrdaRedirect: false
    oldesgRedirect: false
    oldrdaRedirect: false
    oldtdsRedirect: false

volume:
  enabled: true
  readonly: true
  fs:
    existingClaim: gdexdata
    name: gdexdata
    mountPath: /data

enableTest: true
