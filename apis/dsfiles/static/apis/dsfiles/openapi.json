{
  "openapi": "3.1.2",
  "info": {
    "title": "GDEX Data File API",
    "description": "This API allows users to discover files in a specified dataset based on specified filters.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://api.gdex.ucar.edu/dsfiles",
      "description": "(JSON responses)"
    }
  ],
  "paths": {
    "/{DSID}/filters": {
      "get": {
        "summary": "Get dataset-specific filters.",
        "description": "This operation returns the filters that are available for the specified dataset using its GDEX DSID.",
        "operationId": "getDatasetFilters",
        "parameters": [
          {
            "$ref": "#/components/parameters/dsid"
          },
          {
            "$ref": "#/components/parameters/variable"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schema_defs/DatasetFiltersResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "dsid": {
        "name": "DSID",
        "in": "path",
        "description": "Retrieve data for dataset identified by DSID",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "variable": {
        "name": "parameter",
        "in": "query",
        "description": "Restrict to specified parameter code(s)",
        "required": false,
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "default": ""
          }
        },
        "collectionFormat": "multi"
      }
    },
    "schema_defs": {
      "DatasetFiltersResponse": {
        "type": "object",
        "properties": {
          "dataset": {
            "type": "object",
            "properties": {
              "DSID": {
                "type": "string"
              },
              "filters": {
                "type": "object",
                "description": "List of filters available for this dataset",
                "properties": {
                  "valid-dates": {
                    "type": "object",
                    "description": "Date range for which data are valid",
                    "properties": {
                      "min": {
                        "type": "string"
                      },
                      "max": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "BadRequest": {
        "type": "object",
        "properties": {
          "error_message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schema_defs/BadRequest"
            }
          }
        }
      }
    }
  }
}
